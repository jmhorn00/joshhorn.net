{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "joshhorn-net",
  "compatibility_date": "2026-06-01",
  // Static Astro build served as Workers static assets
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
