---
import '../styles/global.css';
import '../styles/book.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Contents from '../components/Contents.astro';
import { profile } from '../data/profile';
import { chapters, chapterFor } from '../data/chapters';

interface Props {
  title?: string;
  description?: string;
  /** Page number shown at the foot of the page; defaults to the chapter's first page. */
  folio?: number;
}

const {
  title,
  description = `${profile.name} is a Python and Django developer in ${profile.location} who builds web apps, healthcare EDI integrations, and AI tools. ${profile.availability}.`,
  folio,
} = Astro.props;

const pageTitle = title ? `${title} · ${profile.name}` : `${profile.name} · Python & Django Developer`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const chapter = chapterFor(Astro.url.pathname);
const pageNumber = folio ?? chapter?.page;
// Chapter order, used to decide which way the page turns
const order = chapters.map((c) => c.href);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#07090c" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#c9d0d9" media="(prefers-color-scheme: light)" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />

    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch (_) {}
    </script>

    <!--
      Page turns: tag each cross-document view transition as "forward" or "backward"
      based on chapter order, so the page flips the right way. Has to run before first
      render, so it lives inline in <head>.
    -->
    <script is:inline define:vars={{ order }}>
      const rank = (url) => {
        const path = new URL(url).pathname.replace(/\/?$/, '/');
        let i = order.findIndex((href, n) => n > 0 && path.startsWith(href));
        if (i === -1) i = 0;
        // nested pages (e.g. a case study) sit just after their chapter
        return i + (path.split('/').filter(Boolean).length > 1 ? 0.5 : 0);
      };
      addEventListener('pagereveal', (e) => {
        const nav = window.navigation;
        if (!e.viewTransition || !nav?.activation?.from || !nav.activation.entry) return;
        const from = rank(nav.activation.from.url);
        const to = rank(nav.activation.entry.url);
        e.viewTransition.types.add(to < from ? 'backward' : 'forward');
      });
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <div class="desk">
      <div class="book">
        <span class="ribbon" aria-hidden="true"></span>
        <aside class="leaf-left" aria-label="Table of contents">
          <Contents />
        </aside>

        <div class="leaf-right" id="leaf">
          <Header />
          <p class="running-head" aria-hidden="true">
            <span>{chapter ? `${chapter.numeral} · ${chapter.title}` : profile.name}</span>
            <span>{profile.name}</span>
          </p>
          <main id="main" class="wrap" tabindex="-1">
            <slot />
          </main>
          <Footer />
          {pageNumber && <p class="folio" aria-hidden="true">{pageNumber}</p>}
        </div>
      </div>
    </div>

    <script>
      // On the two-page layout the right-hand page is its own scroll area; focus it so
      // the keyboard (space, page down, arrows) scrolls the page you're reading.
      const leaf = document.getElementById('leaf');
      if (leaf && getComputedStyle(leaf).overflowY === 'auto') {
        leaf.tabIndex = -1;
        leaf.focus({ preventScroll: true });
      }
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    z-index: 10;
    left: 1rem;
    top: -3rem;
    padding: 0.5rem 0.9rem;
    background: var(--ink);
    color: var(--paper);
  }

  .skip-link:focus {
    top: 1rem;
  }

  #main:focus,
  #leaf:focus {
    outline: none;
  }
</style>
