---
import Base from '../layouts/Base.astro';
import WorkList from '../components/WorkList.astro';
import { profile, experience, skills } from '../data/profile';
import { services } from '../data/services';
import { work } from '../data/work';

const principles = [
  {
    title: 'I run what I build',
    text: "The EDI integration I built runs every day, and when a payer rejects a file, I'm the one reading the acknowledgment. Owning software in production changes how you write it: clear logging, obvious failure modes, and code that's easy to debug.",
  },
  {
    title: 'Plain tools, used well',
    text: "Django, a solid relational database, and a few scheduled jobs solve most business problems. I reach for something heavier when the problem calls for it, not before.",
  },
  {
    title: 'The front end is part of the job',
    text: 'Internal tools get used all day, so fast pages, clear forms, keyboard support, and layouts that work on a phone matter. This site is static HTML with very little JavaScript, and it prints cleanly.',
  },
  {
    title: 'Write it down',
    text: 'A short README, a diagram of where the data goes, a note on why a decision was made. It is the cheapest way to make a system easy for the next person to pick up.',
  },
];

const job = experience[0]!;
const role = job.roles[0]!;
---

<Base>
  <section class="intro">
    <div class="intro-text">
      <h1>
        I'm Josh. I build web apps, integrations, and data tools in <em>Python and Django</em>, mostly
        for the healthcare and insurance world.
      </h1>
      <div class="prose lede">
        <p>
          For the last couple of years I've been the developer at a healthcare claims administrator, where
          my work runs from Django apps and SQL Server to X12 EDI files, Power BI, and the VMware boxes
          everything sits on. Outside of work I tinker with language models and run a small Kubernetes
          cluster at home.
        </p>
        <p>I'm open to remote full-time roles and contract projects.</p>
      </div>
      <p class="links">
        <a class="arrow-link" href="/work/">See the work</a>
        <a href="/services/">What I can help with</a>
      </p>
    </div>

    <dl class="facts">
      <div>
        <dt>Currently</dt>
        <dd>{role.title.split(' / ')[0]} at {job.company}</dd>
      </div>
      <div>
        <dt>Based in</dt>
        <dd>{profile.location}, working remotely</dd>
      </div>
      <div>
        <dt>Education</dt>
        <dd>B.S. MIS, Oklahoma State</dd>
      </div>
      <div>
        <dt>Email</dt>
        <dd><a href={`mailto:${profile.email}`}>{profile.email}</a></dd>
      </div>
    </dl>
  </section>

  <section class="row">
    <h2 class="label">Selected work</h2>
    <div>
      <WorkList items={work.filter((w) => w.kind === 'Day job')} />
      <p class="more"><a class="arrow-link" href="/work/">All work, including side projects</a></p>
    </div>
  </section>

  <section class="row">
    <h2 class="label">How I work</h2>
    <ul class="principles">
      {
        principles.map((p, i) => (
          <li>
            <span class="pnum">{i + 1}</span>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="row">
    <h2 class="label">What I do</h2>
    <div>
      <ol class="service-list">
        {
          services.map((s) => (
            <li>
              <a href={`/services/#${s.slug}`}>{s.title}</a>
            </li>
          ))
        }
      </ol>
      <p class="more"><a class="arrow-link" href="/services/">Details on each</a></p>
    </div>
  </section>

  <section class="row">
    <h2 class="label">Toolkit</h2>
    <dl class="toolkit">
      {
        skills
          .filter((g) => g.group !== 'Practice')
          .map((g) => (
            <div>
              <dt>{g.group}</dt>
              <dd>{g.items.join(', ')}</dd>
            </div>
          ))
      }
    </dl>
  </section>

  <section class="row">
    <h2 class="label">Say hello</h2>
    <div class="prose">
      <p class="hello">
        If you have something you'd like built or fixed, the easiest way to reach me is email:{' '}
        <a href={`mailto:${profile.email}`}>{profile.email}</a>.
      </p>
    </div>
  </section>
</Base>

<style>
  .intro {
    display: grid;
    gap: 3rem;
    padding-block: 3rem 4.5rem;
  }

  @media (min-width: 960px) {
    .intro {
      grid-template-columns: 1fr 17rem;
      gap: 5rem;
      padding-block: 5rem 6rem;
      align-items: end;
    }
  }

  h1 {
    font-size: clamp(2rem, 4.6vw, 3.3rem);
    line-height: 1.12;
    max-width: 22ch;
  }

  h1 em {
    font-style: italic;
    color: var(--accent);
  }

  .lede {
    margin-top: 2rem;
    font-size: 1.1rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    margin-top: 2rem;
  }

  .facts {
    margin: 0;
    display: grid;
    gap: 1.1rem;
    padding-left: 1.5rem;
    border-left: 1px solid var(--rule);
    font-size: 0.95rem;
  }

  .facts dt {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .facts dd {
    margin: 0.1rem 0 0;
    color: var(--ink);
    overflow-wrap: anywhere;
  }

  .service-list {
    columns: 2 14rem;
    column-gap: 3rem;
    counter-reset: svc;
  }

  .service-list li {
    break-inside: avoid;
    counter-increment: svc;
    display: flex;
    gap: 0.9rem;
    padding-block: 0.6rem;
    border-bottom: 1px solid var(--rule);
    font-family: var(--serif);
    font-size: 1.3rem;
  }

  .service-list li::before {
    content: counter(svc, decimal-leading-zero);
    font-family: var(--sans);
    font-size: 0.8rem;
    color: var(--ink-3);
    padding-top: 0.45rem;
    font-variant-numeric: tabular-nums;
  }

  .service-list a {
    text-decoration: none;
  }

  .service-list a:hover {
    color: var(--accent);
  }

  .more {
    margin-top: 1.75rem;
  }










  .hello {
    font-family: var(--serif);
    font-size: 1.5rem;
    line-height: 1.4;
    color: var(--ink);
  }

  .hello a {
    text-decoration-color: var(--accent);
  }

  .principles {
    display: grid;
    gap: 2.25rem 3rem;
  }

  @media (min-width: 760px) {
    .principles {
      grid-template-columns: 1fr 1fr;
    }
  }

  .principles li {
    display: grid;
    align-content: start;
    grid-template-columns: 1.6rem 1fr;
    gap: 0.35rem 0.5rem;
  }

  .pnum {
    grid-row: span 2;
    padding-top: 0.2rem;
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.15rem;
    color: var(--accent);
  }

  .principles h3 {
    font-size: 1.3rem;
  }

  .principles p {
    color: var(--ink-2);
  }

  .toolkit {
    margin: 0;
    display: grid;
    gap: 0.9rem;
    max-width: 48rem;
  }

  .toolkit div {
    display: grid;
    gap: 0.1rem 1.5rem;
  }

  @media (min-width: 640px) {
    .toolkit div {
      grid-template-columns: 9.5rem 1fr;
    }
  }

  .toolkit dt {
    font-weight: 600;
  }

  .toolkit dd {
    margin: 0;
    color: var(--ink-2);
  }
</style>
