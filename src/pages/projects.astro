---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import { profile, projects } from '../data/profile';
---

<Base
  title="Projects"
  description="Side projects by Josh Horn: a document Q&A chatbot, a local AI assistant with MCP tooling, and a GitOps-managed Kubernetes home cluster."
>
  <PageIntro title="Projects">
    <p>
      Things I've built on my own time, mostly to learn something properly. Code for some of them is on
      <a href={profile.github} rel="noopener">GitHub</a>.
    </p>
  </PageIntro>

  {
    projects.map((p) => (
      <section class="row">
        <p class="label">{p.tagline}</p>
        <div class="body">
          <h2>{p.name}</h2>
          <p class="desc">{p.description}</p>
          <p class="stack">{p.tags.join(' · ')}</p>
        </div>
      </section>
    ))
  }
</Base>

<style>
  .body {
    max-width: 44rem;
  }

  h2 {
    font-size: clamp(1.6rem, 3vw, 2rem);
  }

  .desc {
    margin-top: 0.75rem;
    font-size: 1.08rem;
    color: var(--ink-2);
  }

  .stack {
    margin-top: 1rem;
    font-size: 0.88rem;
    color: var(--ink-3);
  }
</style>
