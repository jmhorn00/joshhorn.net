---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import CtaBanner from '../components/CtaBanner.astro';
import { profile, experience, education, skills } from '../data/profile';
---

<Base
  title="Experience"
  description="Josh Horn's professional experience: software development, healthcare EDI, data analysis, and IT infrastructure at The Kempton Group Administrators."
>
  <PageHero eyebrow="Experience" title="Where I've been and what I've shipped" lead={profile.summary}>
    <div class="hero-links">
      <a href={profile.linkedin} target="_blank" rel="noopener" class="btn btn-ghost"
        ><Icon name="linkedin" size={18} /> LinkedIn</a
      >
      <a href={profile.github} target="_blank" rel="noopener" class="btn btn-ghost"
        ><Icon name="github" size={18} /> GitHub</a
      >
    </div>
  </PageHero>

  <section class="section">
    <div class="container layout">
      <div class="timeline">
        {
          experience.map((job) => (
            <article class="job reveal">
              <header class="job-head">
                <div class="logo">
                  <Icon name="briefcase" size={20} />
                </div>
                <div>
                  <h2>{job.company}</h2>
                  <p class="loc">{job.location}</p>
                </div>
              </header>

              <div class="roles">
                {job.roles.map((role) => (
                  <div class="role">
                    <div class="role-head">
                      <h3>{role.title}</h3>
                      <span class="period">{role.period}</span>
                    </div>
                    <ul>
                      {role.highlights.map((h) => (
                        <li>{h}</li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            </article>
          ))
        }

        <article class="job reveal">
          <header class="job-head">
            <div class="logo"><Icon name="cap" size={20} /></div>
            <div>
              <h2>{education.school}</h2>
              <p class="loc">{education.location}</p>
            </div>
          </header>
          <div class="roles">
            <div class="role">
              <div class="role-head">
                <h3>{education.degree}</h3>
                <span class="period">{education.date}</span>
              </div>
            </div>
          </div>
        </article>
      </div>

      <aside class="side">
        <div class="card side-card">
          <h2>Technical skills</h2>
          {
            skills.map((g) => (
              <div class="group">
                <h3>{g.group}</h3>
                <div class="chip-list">
                  {g.items.map((i) => (
                    <span class="chip">{i}</span>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </aside>
    </div>
  </section>

  <CtaBanner title="Want this experience on your team?" />
</Base>

<style>
  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .layout {
    display: grid;
    gap: 3rem;
  }

  @media (min-width: 1000px) {
    .layout {
      grid-template-columns: 1.6fr 1fr;
      align-items: start;
    }

    .side {
      position: sticky;
      top: 6rem;
    }
  }

  .timeline {
    position: relative;
    display: grid;
    gap: 3rem;
  }

  .job {
    position: relative;
    display: grid;
    gap: 1.5rem;
  }

  .job:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 1.4rem;
    top: 3.6rem;
    bottom: -2.4rem;
    width: 1px;
    background: linear-gradient(var(--border-strong), transparent);
  }

  .job-head {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .logo {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.8rem;
    height: 2.8rem;
    border-radius: 12px;
    background: var(--gradient);
    color: #fff;
    box-shadow: var(--shadow-md);
  }

  .job-head h2 {
    font-size: clamp(1.3rem, 2.5vw, 1.6rem);
  }

  .loc {
    color: var(--text-faint);
    font-size: 0.92rem;
  }

  .roles {
    display: grid;
    gap: 1.25rem;
    padding-left: 3.8rem;
  }

  @media (max-width: 600px) {
    .roles {
      padding-left: 0;
    }

    .job::after {
      display: none;
    }
  }

  .role {
    padding: 1.5rem 1.6rem;
    border-radius: var(--radius-lg);
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-sm);
  }

  .role-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.4rem 1rem;
  }

  .role-head h3 {
    font-size: 1.1rem;
  }

  .period {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--accent-text);
    background: var(--accent-soft);
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    white-space: nowrap;
  }

  .role ul {
    display: grid;
    gap: 0.7rem;
    margin-top: 1.1rem;
  }

  .role li {
    position: relative;
    padding-left: 1.2rem;
    color: var(--text-muted);
    font-size: 0.97rem;
  }

  .role li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.65em;
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--accent-2);
  }

  .side-card {
    display: grid;
    gap: 1.4rem;
    padding: 1.75rem;
  }

  .side-card > h2 {
    font-size: 1.2rem;
  }

  .group {
    display: grid;
    gap: 0.6rem;
  }

  .group h3 {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
</style>
