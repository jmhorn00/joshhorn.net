---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import { profile, experience, education, skills } from '../data/profile';
---

<Base
  title="Experience"
  description="Josh Horn's work history: software development, healthcare EDI, data analysis, and IT at The Kempton Group Administrators."
>
  <PageIntro title="Experience">
    <p>
      The short version of my résumé. I'm happy to send the full PDF, just{' '}
      <a href={`mailto:${profile.email}`}>email me</a>.
    </p>
  </PageIntro>

  {
    experience.map((job) => (
      <section class="row">
        <div class="label company-label">
          <span>{job.company}</span>
          <span class="loc">{job.location}</span>
        </div>
        <div class="roles">
          {job.roles.map((role) => (
            <article class="role">
              <div class="role-head">
                <h2>{role.title}</h2>
                <p class="when">{role.period}</p>
              </div>
              <ul class="bullets">
                {role.highlights.map((h) => (
                  <li>{h}</li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </section>
    ))
  }

  <section class="row">
    <div class="label company-label">
      <span>Education</span>
    </div>
    <div class="role-head">
      <h2>{education.degree}</h2>
      <p class="when">{education.school}, {education.location} · {education.date}</p>
    </div>
  </section>

  <section class="row">
    <h2 class="label">Skills</h2>
    <dl class="skills">
      {
        skills.map((g) => (
          <div>
            <dt>{g.group}</dt>
            <dd>{g.items.join(', ')}</dd>
          </div>
        ))
      }
    </dl>
  </section>
</Base>

<style>
  .company-label {
    display: grid;
    align-content: start;
    gap: 0.2rem;
  }

  .loc {
    font-weight: 400;
    letter-spacing: 0.04em;
    text-transform: none;
    font-size: 0.85rem;
  }

  .roles {
    display: grid;
    gap: 2.75rem;
    max-width: 44rem;
  }

  .role-head h2 {
    font-size: 1.6rem;
  }

  .when {
    margin-top: 0.2rem;
    font-size: 0.92rem;
    color: var(--ink-3);
  }

  .bullets {
    margin-top: 1.1rem;
    display: grid;
    gap: 0.7rem;
    color: var(--ink-2);
  }

  .bullets li {
    position: relative;
    padding-left: 1.1rem;
  }

  .bullets li::before {
    content: '–';
    position: absolute;
    left: 0;
    color: var(--ink-3);
  }

  .skills {
    margin: 0;
    display: grid;
    gap: 1.1rem;
    max-width: 44rem;
  }

  .skills div {
    display: grid;
    gap: 0.15rem 1.5rem;
  }

  @media (min-width: 640px) {
    .skills div {
      grid-template-columns: 10rem 1fr;
    }
  }

  .skills dt {
    font-weight: 600;
  }

  .skills dd {
    margin: 0;
    color: var(--ink-2);
  }
</style>
