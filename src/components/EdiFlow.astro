---
// Data flow for the EDI integration, laid out in CSS grid so it reflows
// from a horizontal diagram to a vertical one on narrow screens.
---

<figure class="flow">
  <div class="diagram" role="img" aria-label="Outbound 834 and 837 files flow from the claims system through the Python integration and managed file transfer to trading partners. 835 remittance, acknowledgments, and response files flow back the same way.">
    <div class="node">
      <strong>Claims system</strong>
      <span>source of record</span>
    </div>

    <div class="lanes" aria-hidden="true">
      <div class="lane out"><span>eligibility &amp; claim data</span></div>
      <div class="lane in"><span>loaded back in</span></div>
    </div>

    <div class="node primary">
      <strong>Python integration</strong>
      <span>builds and reads X12</span>
    </div>

    <div class="lanes" aria-hidden="true">
      <div class="lane out"><span>834 · 837 via MFT</span></div>
      <div class="lane in"><span>835 · acks · responses</span></div>
    </div>

    <div class="node">
      <strong>Trading partners</strong>
      <span>vendors, payers, CMS</span>
    </div>
  </div>
  <figcaption>Both directions run through the same integration.</figcaption>
</figure>

<style>
  .flow {
    margin: 2.5rem 0;
  }

  .diagram {
    display: grid;
    grid-template-columns: 1fr 1.1fr 1fr 1.1fr 1fr;
    align-items: center;
  }

  .node {
    display: grid;
    gap: 0.15rem;
    padding: 0.9rem 0.85rem;
    border: 1px solid var(--ink);
    background: var(--paper);
    text-align: center;
    font-size: 0.9rem;
    line-height: 1.3;
  }

  .node strong {
    font-family: var(--serif);
    font-size: 1.05rem;
    font-weight: 600;
  }

  .node span {
    color: var(--ink-3);
    font-size: 0.8rem;
  }

  .node.primary {
    background: var(--ink);
    color: var(--paper);
  }

  .node.primary span {
    color: color-mix(in srgb, var(--paper) 70%, transparent);
  }

  .lanes {
    display: grid;
    gap: 1.6rem;
    padding-inline: 0.4rem;
  }

  .lane {
    position: relative;
    height: 1px;
    background: var(--ink-2);
  }

  .lane span {
    position: absolute;
    left: 50%;
    bottom: 0.35rem;
    transform: translateX(-50%);
    white-space: nowrap;
    font-size: 0.74rem;
    color: var(--ink-2);
  }

  .lane.in span {
    bottom: auto;
    top: 0.35rem;
  }

  /* arrowheads */
  .lane::after {
    content: '';
    position: absolute;
    top: -4px;
    width: 0;
    height: 0;
    border-block: 4.5px solid transparent;
  }

  .lane.out::after {
    right: -1px;
    border-left: 8px solid var(--ink-2);
  }

  .lane.in::after {
    left: -1px;
    border-right: 8px solid var(--ink-2);
  }

  .lane.in {
    background: var(--accent);
  }

  .lane.in::after {
    border-right-color: var(--accent);
  }

  .lane.in span {
    color: var(--accent);
  }

  figcaption {
    margin-top: 1.4rem;
    font-size: 0.85rem;
    color: var(--ink-3);
  }

  /* Vertical layout on narrow screens */
  @media (max-width: 720px) {
    .diagram {
      grid-template-columns: 1fr;
      justify-items: center;
    }

    .node {
      width: min(100%, 16rem);
    }

    .lanes {
      grid-template-columns: 1fr 1fr;
      gap: 0;
      width: min(100%, 16rem);
      height: 4.5rem;
      padding: 0;
    }

    .lane {
      width: 1px;
      height: 100%;
      justify-self: center;
    }

    .lane span {
      left: auto;
      bottom: auto;
      top: 50%;
      transform: translateY(-50%);
      white-space: normal;
      width: 6.5rem;
      line-height: 1.25;
    }

    .lane.out span {
      right: 0.6rem;
      text-align: right;
    }

    .lane.in span {
      top: 50%;
      left: 0.6rem;
    }

    .lane::after {
      top: auto;
      left: -4px;
      right: auto;
      border-inline: 4.5px solid transparent;
      border-block: 0;
    }

    .lane.out::after {
      bottom: -1px;
      border-top: 8px solid var(--ink-2);
    }

    .lane.in::after {
      top: -1px;
      left: -4px;
      border-bottom: 8px solid var(--accent);
    }
  }
</style>
