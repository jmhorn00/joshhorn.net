---
import Icon from './Icon.astro';
import { profile } from '../data/profile';

interface Props {
  title?: string;
  text?: string;
}

const {
  title = 'Have a project in mind?',
  text = `${profile.availability}. Tell me what you're building and I'll get back to you within one business day.`,
} = Astro.props;
---

<section class="section cta-section">
  <div class="container">
    <div class="cta reveal">
      <div class="copy">
        <h2>{title}</h2>
        <p>{text}</p>
      </div>
      <div class="buttons">
        <a href="/contact/" class="btn btn-light">Start a conversation <Icon name="arrow" size={18} /></a>
        <a href={`mailto:${profile.email}`} class="btn btn-outline-light"><Icon name="mail" size={18} /> Email me</a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-section {
    padding-block: 3rem 5rem;
  }

  .cta {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: clamp(2rem, 5vw, 3.5rem);
    border-radius: 28px;
    background:
      radial-gradient(60rem 20rem at 100% 0%, rgba(45, 212, 191, 0.35), transparent 60%),
      radial-gradient(40rem 20rem at 0% 100%, rgba(129, 140, 248, 0.45), transparent 60%),
      #0f1530;
    color: #fff;
    box-shadow: var(--shadow-lg);
  }

  .copy {
    max-width: 36rem;
    display: grid;
    gap: 0.75rem;
  }

  h2 {
    font-size: clamp(1.7rem, 3.5vw, 2.4rem);
  }

  p {
    color: rgba(255, 255, 255, 0.78);
    font-size: 1.05rem;
  }

  .buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .btn-light {
    background: #fff;
    color: #0f1530;
  }

  .btn-outline-light {
    border-color: rgba(255, 255, 255, 0.3);
    color: #fff;
  }

  .btn-outline-light:hover {
    border-color: #fff;
  }
</style>
