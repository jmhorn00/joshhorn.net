---
import Icon from './Icon.astro';
import type { Service } from '../data/services';

interface Props {
  service: Service;
  detailed?: boolean;
}

const { service, detailed = false } = Astro.props;
---

<article class:list={['card', 'service', 'reveal', { detailed }]} id={detailed ? service.slug : undefined}>
  <div class="icon"><Icon name={service.icon} size={22} /></div>
  <h3>{service.title}</h3>
  <p class="summary">{service.summary}</p>
  {
    detailed && (
      <>
        <ul class="deliverables">
          {service.deliverables.map((d) => (
            <li>
              <Icon name="check" size={16} />
              <span>{d}</span>
            </li>
          ))}
        </ul>
        <div class="chip-list">
          {service.stack.map((s) => (
            <span class="chip">{s}</span>
          ))}
        </div>
      </>
    )
  }
</article>

<style>
  .service {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 1.75rem;
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .service:hover {
    transform: translateY(-3px);
    border-color: var(--border-strong);
    box-shadow: var(--shadow-md);
  }

  .icon {
    display: grid;
    place-items: center;
    width: 2.9rem;
    height: 2.9rem;
    border-radius: 12px;
    background: var(--accent-soft);
    color: var(--accent-text);
    border: 1px solid color-mix(in srgb, var(--accent) 22%, transparent);
  }

  h3 {
    font-size: 1.15rem;
    margin-top: 0.35rem;
  }

  .summary {
    color: var(--text-muted);
    font-size: 0.96rem;
  }

  .deliverables {
    display: grid;
    gap: 0.55rem;
    margin-block: 0.4rem 0.6rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }

  .deliverables li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.6rem;
    font-size: 0.93rem;
    color: var(--text);
  }

  .deliverables li :global(svg) {
    margin-top: 0.25rem;
    color: var(--accent-2);
  }

  .chip-list {
    margin-top: auto;
  }
</style>
