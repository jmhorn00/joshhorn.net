---
import type { Project } from '../data/profile';

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
---

<article class="card project reveal">
  <div class="top">
    <span class="num">{String(index + 1).padStart(2, '0')}</span>
    <span class="tagline">{project.tagline}</span>
  </div>
  <h3>{project.name}</h3>
  <p>{project.description}</p>
  <div class="chip-list">
    {project.tags.map((t) => <span class="chip">{t}</span>)}
  </div>
</article>

<style>
  .project {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: 1.9rem;
    overflow: hidden;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      border-color 0.2s ease;
  }

  .project::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 3px;
    background: var(--gradient);
    opacity: 0.85;
  }

  .project:hover {
    transform: translateY(-3px);
    border-color: var(--border-strong);
    box-shadow: var(--shadow-md);
  }

  .top {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  .num {
    color: var(--accent-text);
    font-weight: 600;
  }

  .tagline {
    color: var(--text-faint);
  }

  h3 {
    font-size: 1.3rem;
  }

  p {
    color: var(--text-muted);
    font-size: 0.97rem;
  }

  .chip-list {
    margin-top: auto;
    padding-top: 0.4rem;
  }
</style>
